# attacker-web 환경 변수 예시
# EC2 #1: cp .env.example .env 후 Dummy EC2 IP / ALB DNS 로 수정

# Phase 1: Dummy EC2 private IP 또는 docker-compose 서비스명
TARGET_URL=http://dummy-web:8000/api/load?ms=100

# 허용 호스트 (쉼표 구분) — 이 목록 외 URL 은 API 거부
ALLOWED_TARGET_HOSTS=dummy-web,localhost,127.0.0.1

# RPS 상한
MAX_RPS=5000

MAX_CONNECTIONS=500
REQUEST_TIMEOUT_SEC=10.0
